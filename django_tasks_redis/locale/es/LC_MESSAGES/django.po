#: apps.py:8 models.py:31
msgid "Redis Tasks"
msgstr "Tareas de Redis"

#: management/commands/purge_completed_redis_tasks.py:18
msgid "Delete completed Redis tasks older than specified days"
msgstr "Elimina las tareas de Redis completadas hace más de los días especificados"

#: management/commands/purge_completed_redis_tasks.py:25
msgid "Delete tasks completed more than N days ago (default: 7)"
msgstr "Elimina las tareas completadas hace más de N días (predeterminado: 7)"

#: management/commands/purge_completed_redis_tasks.py:33
msgid ""
"Status to delete (can be specified multiple times, default: SUCCESSFUL,"
"FAILED)"
msgstr "Estado a eliminar (se puede indicar varias veces, predeterminado: SUCCESSFUL,FAILED)"

#: management/commands/purge_completed_redis_tasks.py:39
msgid "Only delete tasks with this task path (default: all tasks)"
msgstr "Elimina solo las tareas con esta ruta de tarea (predeterminado: todas las tareas)"

#: management/commands/purge_completed_redis_tasks.py:45
#: management/commands/rebuild_redis_status_index.py:30
msgid "Tasks read per round trip (default: REDIS_SCAN_BATCH_SIZE)"
msgstr "Tareas leídas por viaje de ida y vuelta al servidor (predeterminado: REDIS_SCAN_BATCH_SIZE)"

#: management/commands/purge_completed_redis_tasks.py:51
msgid "Only show count, don't actually delete"
msgstr "Solo muestra el recuento, sin eliminar nada"

#: management/commands/purge_completed_redis_tasks.py:57
#: management/commands/rebuild_redis_status_index.py:36
#: management/commands/run_redis_tasks.py:73
msgid "Backend name (default: default)"
msgstr "Nombre del backend (predeterminado: default)"

#: management/commands/rebuild_redis_status_index.py:23
msgid "Rebuild the status index the task counts are read from"
msgstr "Reconstruye el índice de estados del que se leen los recuentos de tareas"

#: management/commands/run_redis_tasks.py:60
msgid "Run a worker to process Redis tasks"
msgstr "Ejecuta un worker para procesar tareas de Redis"

#: management/commands/run_redis_tasks.py:67
msgid "Process only tasks from specific queue"
msgstr "Procesa solo las tareas de la cola especificada"

#: management/commands/run_redis_tasks.py:79
msgid "Run continuously (don't exit when queue is empty)"
msgstr "Se ejecuta de forma continua (no termina cuando la cola está vacía)"

#: management/commands/run_redis_tasks.py:85
msgid "Polling interval in seconds (default: 1.0)"
msgstr "Intervalo de sondeo en segundos (predeterminado: 1.0)"

#: management/commands/run_redis_tasks.py:91
msgid "Maximum number of tasks to process (0 = unlimited)"
msgstr "Número máximo de tareas a procesar (0 = ilimitado)"

#: management/commands/run_redis_tasks.py:97
msgid "Stale task claim interval in seconds (default: 60.0)"
msgstr "Intervalo en segundos para reclamar tareas estancadas (predeterminado: 60.0)"

#: management/commands/run_redis_tasks.py:104
msgid ""
"Maximum seconds to wait for the running task after receiving SIGTERM/SIGINT "
"before forcing exit (0=wait indefinitely, default: 0)"
msgstr "Segundos máximos de espera a la tarea en ejecución tras recibir SIGTERM/SIGINT antes de forzar la salida (0=esperar indefinidamente, predeterminado: 0)"

#: management/commands/run_redis_tasks.py:112
msgid ""
"Do not install SIGTERM/SIGINT handlers; the process is terminated "
"immediately, even while a task is running"
msgstr "No instala manejadores de SIGTERM/SIGINT; el proceso termina de inmediato, incluso con una tarea en ejecución"

#: management/commands/run_redis_tasks.py:122
msgid ""
"Exit with this code when no task was processed, so a job scheduler can tell "
"an idle run from a real one (0=exit normally, default: 0)"
msgstr "Termina con este código cuando no se procesó ninguna tarea, para que un planificador de trabajos distinga una ejecución vacía de una real (0=terminar normalmente, predeterminado: 0)"

#: management/commands/run_redis_tasks.py:133
msgid ""
"Exit with this code when at least one task failed or could not be run. Takes "
"precedence over --empty-exit-code (0=exit normally, default: 0)"
msgstr "Termina con este código cuando al menos una tarea falló o no se pudo ejecutar. Tiene prioridad sobre --empty-exit-code (0=terminar normalmente, predeterminado: 0)"

#: models.py:29
msgid "Can run Redis task"
msgstr "Puede ejecutar tarea de Redis"

